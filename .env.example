# DB for containers (api uses this)
DATABASE_URL=postgresql://studio:studio@db:5432/studio?sslmode=disable
POSTGRES_HOST_PORT=55432
API_PORT=8080
# At least 32 random bytes; never reuse this example value in production.
AUTH_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
# Set to true whenever the API is served over HTTPS.
COOKIE_SECURE=false
# Comma-separated proxy networks allowed to supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

# Web talks to API from your browser
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side URL; Compose overrides this with http://api:8080.
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-a-domain-restricted-key

# Contact email (server-side only)
RESEND_API_KEY=replace-with-a-resend-api-key
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=Studio Website <website@example.com>
# Per web instance. Use a shared edge/gateway limiter when running multiple instances.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
UPLOAD_CLEANUP_GRACE_HOURS=24
