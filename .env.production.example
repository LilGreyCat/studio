# Compose interpolation and PostgreSQL initialization
POSTGRES_USER=studio
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=studio
DATABASE_URL=postgresql://studio:replace-with-a-strong-database-password@db:5432/studio?sslmode=disable

# API
API_PORT=8080
AUTH_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_URL=https://nhadesrecords.fr
COOKIE_SECURE=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Public browser configuration (baked into the web image)
NEXT_PUBLIC_API_URL=https://api.nhadesrecords.fr
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-a-domain-restricted-key

# Contact email (web runtime only)
RESEND_API_KEY=replace-with-a-resend-api-key
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=Studio Website <website@example.com>
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600

# Loopback ports consumed by the host TLS reverse proxy
WEB_HOST_PORT=3000
API_HOST_PORT=8080

# Set these only while running `make prod-create-admin`, then remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
