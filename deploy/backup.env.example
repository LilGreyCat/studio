# Absolute directory retained on the VPS for quick restores.
BACKUP_DIR=/var/backups/nhadesrecords
BACKUP_RETENTION_DAYS=14

# A dedicated, narrowly scoped rclone destination. Configure its credentials
# separately with `rclone config` for the service account running the timer.
BACKUP_REMOTE=b2:replace-with-private-bucket/nhadesrecords

# Only needed if the checkout or production environment uses another path.
REPO_DIR=/opt/nhadesrecords
ENV_FILE=/opt/nhadesrecords/.env.production
